@echo OFF
>nul 2>&1 "%SYSTEMROOT%\system32\cacls.exe" "%SYSTEMROOT%\system32\config\system"
if '%errorlevel%' NEQ '0' (
	echo Accediendo a privilegios administrativos...
	echo Es necesario para que el instalador se ejecute. && echo.
	echo Si no se ejecuta con privilegios de administrador
	echo el script se cerrara y no se instalara nada. && echo. && echo.
	pause
	goto UACPrompt
) else ( goto gotAdmin )
:UACPrompt
	echo Set UAC = CreateObject^("Shell.Application"^) > "%temp%\getadmin.vbs"
	set params = %*:"=""
	echo UAC.ShellExecute "cmd.exe", "/c %~s0 %params%", "", "runas", 1 >> "%temp%\getadmin.vbs"
	"%temp%\getadmin.vbs"
	del "%temp%\getadmin.vbs"
	exit /B
:gotAdmin
setlocal
where pwsh >nul 2>nul
if %errorlevel% equ 0 (
    for /f "usebackq delims=" %%i in (`pwsh -nologo -command "[System.IO.Path]::GetFullPath('%~dp0')"`) do set "CURRENT_PATH=%%i"
) else (
    for /f "usebackq delims=" %%i in (`powershell -nologo -command "[System.IO.Path]::GetFullPath('%~dp0')"`) do set "CURRENT_PATH=%%i"
)
set "TARGET_PATH=C:\Program Files\mpv\"
set "NOMBRE_ARCHIVO=%~nx0"
if not exist "%TARGET_PATH%" (
	mkdir "%TARGET_PATH%"
	echo Carpeta %TARGET_PATH% creada.
)
if not exist "%TARGET_PATH%installer\" (
	mkdir "%TARGET_PATH%installer\"
	echo Carpeta %TARGET_PATH%installer\ creada
)
if /I not "%CURRENT_PATH%%NOMBRE_ARCHIVO%"=="%TARGET_PATH%updater.bat" (
	copy "%CURRENT_PATH%%NOMBRE_ARCHIVO%" "%TARGET_PATH%updater.bat" > nul
	echo Archivo actual copiado a %TARGET_PATH%updater.bat
	start "Ejecutando script..." "%TARGET_PATH%updater.bat"
	del "%CURRENT_PATH%%NOMBRE_ARCHIVO%"
	exit /b
)
